# ENV=development makes the server start browser-sync (live reload on
# RELOAD_PORT) and nodemon itself. Leave it out in production.
ENV=development
PORT=3000
HOST=localhost
RELOAD_PORT=8080

# Optional. Without DB_HOST the server runs without a database.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=password
DB_NAME=elemental

# Optional. For the contact form: the account it sends from (Gmail unless
# EMAIL_SERVICE says otherwise; for Gmail, EMAIL_PASS is an app password)
# and where messages go. Without these, the form says it isn't set up yet.
EMAIL_SERVICE=gmail
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
CONTACT_EMAIL=
