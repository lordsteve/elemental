# ENV=development makes the server start browser-sync (live reload on
# RELOAD_PORT) and nodemon itself. Leave it out in production.
ENV=development
PORT=3000
HOST=localhost
RELOAD_PORT=8080

# Optional. Without DB_HOST the server runs without a database and
# logging in is turned off.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=password
DB_NAME=elemental

# Optional. Discord login, from an application at
# https://discord.com/developers/applications. LOGIN_REDIRECT_URL must be
# listed as a redirect there and point at /data/auth-redirect.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
LOGIN_REDIRECT_URL=http://localhost:3000/data/auth-redirect
